# Local development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ludo-arena?retryWrites=true&w=majority
JWT_SECRET=ludo-arena-dev-secret-change-me
COOKIE_NAME=ludo_session
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:4200
PORT=3000
SEED_ON_BOOT=true

# Render / production
# COOKIE_SECURE=true
# CLIENT_ORIGIN=https://YOUR-SERVICE.onrender.com
# SEED_ON_BOOT=true   # set false after the first successful boot
# PORT is set by the host — do not hardcode it
