# Docker Compose environment for Ludo Arena.
# Copy to .env and fill in:  cp .env.example .env

# --- Mongo -----------------------------------------------------------------
# Pick the form that matches your database:
#   LAN / remote   mongodb://user:pass@192.168.168.2:27017/ludo-arena
#   Atlas          mongodb+srv://user:pass@cluster.mongodb.net/ludo-arena
#   this machine   mongodb://host.docker.internal:27017/ludo-arena
#                  (requires mongod to bind beyond 127.0.0.1 — see
#                   the notes at the bottom of docker-compose.yml)
MONGODB_URI=mongodb://user:pass@192.168.168.2:27017/ludo-arena

# --- App -------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string

COOKIE_NAME=ludo_session
# Must stay false while serving over plain http on localhost.
COOKIE_SECURE=false

# Origin the browser uses; must match PORT above.
CLIENT_ORIGIN=http://localhost:3000

# Creates the admin@ludo.arena account on first boot. Set false afterwards.
SEED_ON_BOOT=true
